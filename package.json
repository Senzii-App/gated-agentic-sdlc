  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.13.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
