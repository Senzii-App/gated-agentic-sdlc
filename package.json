{
  "name": "gated-agentic-sdlc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "invariants": "bash scripts/ci-invariants.sh",
    "test": "vitest run",
    "test:ci": "TEST_PROVISIONER=testcontainers vitest run",
    "dev": "tsx src/http/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
