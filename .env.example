# Copy to .env and fill in. GENERATION HINT for secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Fail-closed per SPEC-001 §6.3: SESSION_SECRET that is empty or a known
# historical default refuses startup. There is no safe default value.
SESSION_SECRET=
DATABASE_URL=
MCP_PORT=3001
BASE_URL=http://localhost:3001

# Test-only: provisioning backend for the test database harness.
# embedded (default, local) | testcontainers (CI sets this)
TEST_PROVISIONER=embedded